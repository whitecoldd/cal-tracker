<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the process starts. Black rather than Theme.Light: the app has
         one skin and it is dark, so a light window behind it would flash white
         on every cold start. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Behind the Flutter UI once it is running. Void black, so an
         over-scroll or a keyboard transition never reveals a white gap. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
