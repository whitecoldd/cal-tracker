<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaced the windowBackground splash with a real API. Without
     this, 12+ devices draw the system default (the launcher icon on the theme
     background) and ignore launch_background.xml entirely. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
